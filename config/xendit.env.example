XENDIT_SUCCESS_RETURN_URL=http://localhost:3000/topup/return
XENDIT_FAILURE_RETURN_URL=http://localhost:3000/topup/return
TOPUP_MIN_AMOUNT=10000
TOPUP_MAX_AMOUNT=10000000
